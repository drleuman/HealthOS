# Vercel / Production Settings Template
NODE_ENV=production

# Public URLs
NEXT_PUBLIC_APP_ORIGIN=https://healthos.vercel.app
NEXT_PUBLIC_API_ORIGIN=https://api.healthos.app

APP_ORIGIN=https://healthos.vercel.app
API_ORIGIN=https://api.healthos.app

# Database (External)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/healthos?schema=public

# SECURITY — Generated secrets
API_JWT_SECRET=<<<32+ random chars>>>
SSO_JWT_SECRET=<<<32+ random chars>>>
WEBHOOK_SECRET=<<<32+ random chars>>>

# WordPress bridge
WP_CHECK_SUBSCRIPTION_URL=https://lanutricionadora.com/wp-json/healthos/v1/check-subscription
WP_SHARED_SECRET=<<<random 32 chars>>>
