# Vercel / Staging / Production Settings Template
NODE_ENV=production

# Public URLs (Replace with real domains)
NEXT_PUBLIC_APP_ORIGIN=https://healthos.vercel.app
NEXT_PUBLIC_API_ORIGIN=https://api.healthos.app
NEXT_PUBLIC_API_URL=https://api.healthos.app

APP_ORIGIN=https://healthos.vercel.app
API_ORIGIN=https://api.healthos.app
PORT=8080

# Database (Production MySQL)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/healthos

# SECURITY — Generated strong secrets (At least 32 characters each)
API_JWT_SECRET=<<<32+ random chars>>>
SSO_JWT_SECRET=<<<32+ random chars>>>
WEBHOOK_SECRET=<<<32+ random chars>>>

# Closed Beta Allowlist
BETA_ALLOWLIST_REQUIRED=true
BETA_ALLOWLIST=email1@domain.com,email2@domain.com
ADMIN_EMAILS=doctorleuman@gmail.com,admin@healthos.app

# Internal Observability Secrets
X_INTERNAL_SECRET=<<<secure random secret>>>
INTERNAL_HEALTH_SECRET=<<<secure random secret>>>
ANALYTICS_SECRET=<<<secure random secret>>>

# Observability Services (Sentry & PostHog)
SENTRY_DSN=https://sentry.io/etc
NEXT_PUBLIC_SENTRY_DSN=https://sentry.io/etc
NEXT_PUBLIC_APP_VERSION=1.0.0-rc1
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# WordPress Bridge / WooCommerce Integration
WP_CHECK_SUBSCRIPTION_URL=https://lanutricionadora.com/wp-json/healthos/v1/check-subscription
WP_SHARED_SECRET=<<<random 32 chars>>>
WC_BASE_URL=https://mithohacks.com
WC_CONSUMER_KEY=your_woocommerce_consumer_key
WC_CONSUMER_SECRET=your_woocommerce_consumer_secret
WC_API_VERSION=v3
WC_CHECKOUT_URL=https://mithohacks.com/pago/

