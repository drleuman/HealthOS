# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database
POSTGRES_USER=healthos
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=healthos
DATABASE_URL=postgresql://healthos:<password>@postgres:5432/healthos

# API Secrets (generate with: openssl rand -base64 64)
API_JWT_SECRET=<generate-64-char-secret>
WEBHOOK_SECRET=<generate-64-char-secret>
SSO_JWT_SECRET=<generate-64-char-secret>

# Application
NODE_ENV=production
APP_ORIGIN=https://app.healthos.com
LOG_LEVEL=info
PORT=4000

# Optional
# REDIS_URL=redis://redis:6379
