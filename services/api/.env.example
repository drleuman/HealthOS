# Local Development Secrets
# Frontend
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4001

# Backend
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4001
PORT=4001

# Database
DATABASE_URL=postgresql://healthos:healthos@localhost:5432/healthos?schema=public

# Secrets
API_JWT_SECRET=your_api_jwt_secret
SSO_JWT_SECRET=your_sso_jwt_secret
WEBHOOK_SECRET=your_webhook_secret

# WP bridge
WP_CHECK_SUBSCRIPTION_URL=https://lanutricionadora.com/wp-json/healthos/v1/check-subscription
WP_SHARED_SECRET=your_wp_secret

# WooCommerce (Mithohacks)
WC_BASE_URL=https://mithohacks.com
WC_CONSUMER_KEY=your_woocommerce_consumer_key
WC_CONSUMER_SECRET=your_woocommerce_consumer_secret
WC_API_VERSION=v3
WC_CHECKOUT_URL=https://mithohacks.com/pago/
