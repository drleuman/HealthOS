# Local Development Secrets
# Frontend & Backend Origins
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4001
PORT=4001

# Database Configuration (MySQL required)
DATABASE_URL=mysql://healthos:healthos@localhost:3306/healthos

# Authentication & JWT Secrets
API_JWT_SECRET=change_me_api_jwt_secret_must_be_long_in_production
SSO_JWT_SECRET=change_me_sso_jwt_secret
WEBHOOK_SECRET=change_me_webhook_secret

# Closed Beta Allowlist Configuration
BETA_ALLOWLIST_REQUIRED=true
BETA_ALLOWLIST=beta_member@healthos.app,user_test@healthos.app
ADMIN_EMAILS=doctorleuman@gmail.com,admin@healthos.app

# Internal Observability & Ops Secrets
X_INTERNAL_SECRET=dev_secret
INTERNAL_HEALTH_SECRET=dev_secret
ANALYTICS_SECRET=admin-secret-dev

# Observability Configuration (Optional for Dev, Recommended for Prod)
SENTRY_DSN=

# WP Bridge (WooCommerce)
WP_CHECK_SUBSCRIPTION_URL=https://lanutricionadora.com/wp-json/healthos/v1/check-subscription
WP_SHARED_SECRET=your_wp_secret
WC_BASE_URL=https://mithohacks.com
WC_CONSUMER_KEY=your_woocommerce_consumer_key
WC_CONSUMER_SECRET=your_woocommerce_consumer_secret
WC_API_VERSION=v3
WC_CHECKOUT_URL=https://mithohacks.com/pago/

